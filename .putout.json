{
    "ignore": ["out"],
    "rules": {
        "madrun/set-lint-dot": "off",
        "optional-chaining/convert-logical-to-optional": "off",
        "optional-chaining/convert-logical-assign-to-optional": "off",
        "optional-chaining/convert-optional-to-logical": "on",
        "optional-chaining/convert-optional-assign-to-logical": "on",
        "putout-editor/remove-comments": "off"
    },
    "match": {
        ".filesystem.json": {
            "putout-editor/check-documented-scripts": "on",
            "putout-editor/check-main-imports-in-file": "on",
            "putout-editor/remove-undefined-token-file": "on",
            "putout-editor/remove-rgb-outside-token-file": "on",
            "putout-editor/remove-z-index-outside-token-file": "on"
        },
        "*.md": {
            "destructuring/apply-object": "off",
            "logical-expressions/apply-destructuring": "off",
            "regexp/apply-literal-notation": "off",
            "putout-editor/apply-press-modifier-case": "off",
            "putout-editor/remove-comments": "off",
            "putout/declare": "off"
        }
    },
    "plugins": [
        "putout-editor"
    ]
}
