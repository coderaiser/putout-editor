{
    "skipFull": false,
    "checkCoverage": true,
    "all": true,
    "exclude": [
        "**/*.spec.*",
        "**/*.config.*",
        "**/.*.*",
        "src/index.tsx",
        "src/store/state.ts",
        "src/store/types.ts",
        "e2e/**",
        "coverage",
        "src/shims/**",
