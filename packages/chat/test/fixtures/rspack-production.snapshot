{
    "entry": {
        "chat": "./src/index.tsx"
    },
    "mode": "production",
    "module": {
        "rules": [
            {
                "exclude": [
                    "<modules>/@putout/engine-loader"
                ],
                "resolve": {
                    "fullySpecified": false
                },
                "test": "/\\.(jsx?|mjs|tsx?)$/",
                "type": "javascript/auto",
                "use": [
                    {
                        "loader": "builtin:swc-loader",
                        "options": {
                            "env": {
                                "targets": "last 2 Chrome versions, last 2 Safari versions, Firefox ESR, not dead"
                            },
                            "jsc": {
                                "externalHelpers": true,
                                "parser": {
                                    "syntax": "typescript",
                                    "tsx": true
                                },
                                "transform": {
                                    "react": {
                                        "development": false,
                                        "runtime": "automatic"
                                    }
                                }
                            }
                        }
                    }
                ]
            },
            {
                "include": [
                    "<root>/packages/chat/src"
                ],
                "test": "/\\.(jsx?|tsx?)$/",
                "use": [
                    "@putout/editor-builder/loader"
                ]
            },
            {
                "test": "/\\.css$/",
                "use": [
                    "<modules>/@rspack/core/dist/cssExtractLoader.js",
                    {
                        "loader": "css-loader",
                        "options": {
                            "importLoaders": 1
                        }
                    }
                ]
            }
        ]
    },
    "optimization": {
        "minimizer": [
            {
                "$class": "SwcJsMinimizerRspackPlugin",
                "_args": [
                    {
                        "minimizerOptions": {
                            "compress": {
                                "keep_fnames": true
                            },
                            "ecma": 2022,
                            "format": {
                                "ecma": 2022
                            },
                            "mangle": {
                                "keep_fnames": true
                            }
                        }
                    }
                ],
                "affectedHooks": "compilation",
                "name": "SwcJsMinimizerRspackPlugin"
            }
        ],
        "moduleIds": "deterministic",
        "runtimeChunk": "single",
        "splitChunks": {
            "cacheGroups": {
                "codemirror": {
                    "chunks": "async",
                    "enforce": true,
                    "minChunks": 1,
                    "minSize": 1,
                    "name": "codemirror",
                    "priority": 25,
                    "test": "/\\/node_modules\\/(@codemirror|@lezer|@replit\\/codemirror|@uiw\\/codemirror|qword)\\//"
                },
                "putout": {
                    "chunks": "async",
                    "minChunks": 1,
                    "minSize": 1,
                    "name": "putout",
                    "priority": 20,
                    "test": "/\\/node_modules\\/(putout|@putout)\\//"
                },
                "react": {
                    "chunks": "all",
                    "minChunks": 1,
                    "minSize": 1,
                    "name": "react",
                    "priority": 15,
                    "test": "/\\/node_modules\\/(react|react-dom|react-redux|@reduxjs)\\//"
                },
                "vendors": {
                    "chunks": "chunks(chunk) { return chunk.name === 'chat'; }",
                    "priority": 5,
                    "test": "/\\/node_modules\\//"
                }
            }
        }
    },
    "output": {
        "chunkFilename": "chat/[name]-[contenthash]-<cache>.js",
        "filename": "chat/[name]-[contenthash]-<cache>.js",
        "path": "<root>/out"
    },
    "performance": {
        "maxAssetSize": 3145728,
        "maxEntrypointSize": 7340032
    },
    "plugins": [
        {
            "$class": "ContextReplacementPlugin",
            "_args": [
                "/@putout\\/engine-loader/",
                "/NEVER_MATCH^/"
            ],
            "name": "ContextReplacementPlugin"
        },
        {
            "$class": "CssExtractRspackPlugin",
            "options": {
                "filename": "chat/[name]-[contenthash]-<cache>.css"
            }
        },
        {
            "$class": "DefinePlugin",
            "_args": [
                {
                    "process.env.API_HOST": "\"\""
                }
            ],
            "affectedHooks": "compilation",
            "name": "DefinePlugin"
        },
        {
            "$class": "HtmlWebpackPlugin",
            "options": {
                "base": false,
                "cache": true,
                "chunks": "all",
                "chunksSortMode": "auto",
                "compile": true,
                "excludeChunks": [],
                "favicon": "./favicon.png",
                "filename": "chat/index.html",
                "hash": false,
                "inject": "body",
                "meta": {},
                "minify": "auto",
                "publicPath": "auto",
                "scriptLoading": "defer",
                "showErrors": true,
                "template": "./index.ejs",
                "templateContent": false,
                "templateParameters": "function templateParametersGenerator(compilation, assets, assetTags, options) { return { compilation: compilation, webpackConfig: compilation.options, htmlWebpackPlugin: { tags: assetTags, files: assets, options: options, }, }; }",
                "title": "Webpack App",
                "version": "<version>",
                "xhtml": false
            },
            "userOptions": {
                "favicon": "./favicon.png",
                "filename": "chat/index.html",
                "inject": "body",
                "template": "./index.ejs",
                "version": "<version>"
            },
            "version": 5
        },
        {
            "$class": "IgnorePlugin",
            "_args": [
                {
                    "resourceRegExp": "/@putout\\/bundler/"
                }
            ],
            "name": "IgnorePlugin"
        },
        {
            "$class": "IgnorePlugin",
            "_args": [
                {
                    "resourceRegExp": "/cosmiconfig/"
                }
            ],
            "name": "IgnorePlugin"
        },
        {
            "$class": "IgnorePlugin",
            "_args": [
                {
                    "resourceRegExp": "/env-paths/"
                }
            ],
            "name": "IgnorePlugin"
        },
        {
            "$class": "IgnorePlugin",
            "_args": [
                {
                    "resourceRegExp": "/globby/"
                }
            ],
            "name": "IgnorePlugin"
        },
        {
            "$class": "IgnorePlugin",
            "_args": [
                {
                    "resourceRegExp": "/hermes-parser/"
                }
            ],
            "name": "IgnorePlugin"
        },
        {
            "$class": "IgnorePlugin",
            "_args": [
                {
                    "resourceRegExp": "/import-meta-resolve/"
                }
            ],
            "name": "IgnorePlugin"
        },
        {
            "$class": "IgnorePlugin",
            "_args": [
                {
                    "resourceRegExp": "/stylelint/"
                }
            ],
            "name": "IgnorePlugin"
        },
        {
            "$class": "IgnorePlugin",
            "_args": [
                {
                    "resourceRegExp": "/supports-hyperlinks/"
                }
            ],
            "name": "IgnorePlugin"
        },
        {
            "$class": "IgnorePlugin",
            "_args": [
                {
                    "resourceRegExp": "/unicorn-magic/"
                }
            ],
            "name": "IgnorePlugin"
        },
        {
            "$class": "NormalModuleReplacementPlugin",
            "_args": [
                "/^@putout\\/operator-match-files$/",
                "<root>/packages/chat/src/shims/empty.js"
            ],
            "name": "NormalModuleReplacementPlugin"
        },
        {
            "$class": "NormalModuleReplacementPlugin",
            "_args": [
                "/^@putout\\/processor-css$/",
                "<root>/packages/chat/src/shims/empty.js"
            ],
            "name": "NormalModuleReplacementPlugin"
        },
        {
            "$class": "NormalModuleReplacementPlugin",
            "_args": [
                "/^node:/",
                "(resource) => { resource.request = resource.request.replace(/^node:/, \"\"); }"
            ],
            "name": "NormalModuleReplacementPlugin"
        },
        {
            "$class": "ProvidePlugin",
            "_args": [
                {
                    "process": "process/browser"
                }
            ],
            "affectedHooks": "compilation",
            "name": "ProvidePlugin"
        }
    ],
    "resolve": {
        "alias": {
            "#store": "<root>/packages/chat/src/store/index.ts",
            "#test/store": "<root>/packages/chat/test/store.ts"
        },
        "extensions": [
            ".ts",
            ".tsx",
            ".js",
            ".jsx"
        ],
        "fallback": {
            "assert": "assert",
            "async_hooks": false,
            "buffer": "<modules>/buffer/index.js",
            "child_process": false,
            "constants": false,
            "crypto": false,
            "events": "<modules>/events/events.js",
            "fs": false,
            "inspector": false,
            "jscodeshift": false,
            "module": false,
            "net": false,
            "os": false,
            "path": "<modules>/path-browserify/index.js",
            "perf_hooks": false,
            "process": "<modules>/process/browser.js",
            "process/browser": "<modules>/process/browser.js",
            "readline": false,
            "stream": false,
            "tty": "<modules>/tty-browserify/index.js",
            "url": "<modules>/url/url.js",
            "util": "util",
            "v8": false,
            "worker_threads": false,
            "zlib": false
        }
    }
}
