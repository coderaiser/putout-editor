{
    "match": {
        "*.js": {
            "putout-editor/remove-comments": "on"
        },
        "*.md": {
            "putout-editor": "off",
            "logical-expressions/apply-destructuring": "off",
            "logical-expressions/simplify": "off",
            "typescript/apply-type-guards": "off"
        }
    }
}
