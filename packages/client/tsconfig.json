{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "allowJs": true,
        "checkJs": false,
        "paths": {
            "@editor/*":  ["./src/editor/*"],
            "@store/*":   ["./src/store/*"],
            "@parser/*":  ["./src/parser/*"],
            "@snippet/*": ["./src/snippet/*"],
            "@ui/*":      ["./src/ui/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
