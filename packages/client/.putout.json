{
    "rules": {
        "remove-console": "off",
        "esm/remove-empty-import": "off",
        "apply-optional-chaining": "on",
        "nodejs/convert-commonjs-to-esm/commons": "off",
        "nodejs/convert-esm-to-commonjs": "off",
        "nodejs/declare": "off"
    },
    "ignore": [
        "test-results/**"
    ],
    "match": {
        ".filesystem.json": {
            "putout-editor/remove-rgb-outside-tokens": "on",
            "putout-editor/remove-z-index-outside-tokens": "on"
        }
    }
}
